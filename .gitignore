# ML artifacts
checkpoints/
runs/
wandb/
mlruns/
*.pt
*.pth
*.ckpt

# M8 deployment bundle — regenerated by scripts/export_weights.py and uploaded
# to a HF *model* repo, not to git. The weights are already covered by *.pt
# above; this also keeps the copied config/tokenizer/meta out, since each is a
# duplicate of a file already committed elsewhere in the repo.
export/

# Data — exclude the large derived corpora, but keep the small JSON metadata
# (stats.json, meta.json) committed: docs/DATA_CARD.md and scripts/export_spec.py
# trace their numbers back to these files, so they need to be real artifacts,
# not regenerated-and-hoped-identical.
data/raw/
data/processed/*.jsonl
data/tokenized/*.bin
*.arrow

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Env secrets
.env
.env.*
